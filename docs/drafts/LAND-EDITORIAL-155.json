  "candidates": [
    {
      "id": "155-01",
      "characterId": "maud-overhead",
      "platform": "instagram",
      "contentType": "story",
      "theme": "movement",
      "title": "The small end",
      "body": "Hung under the rail with my wings folded.\n\nFor a while I was completely still. Then I began to notice my toes.\n\nAll of me was hanging from them.\n\nOpened one wing, just to help. Started swinging.\n\nClosed it again. Left the work to my feet.",
      "photoId": 25664009,
      "localPath": "/tmp/freed-land155/25664009.jpg",
      "mediaSha1": "e76f4d51b2b0f48c77321fd3d3cb3a6acb19e74d",
      "visibleScene": "A common raven hangs head downward from a horizontal rail beneath a panel structure. Both gripping feet and folded wings are clearly visible. The frame is somewhat soft/backlit but the unusual posture and support are legible.",
      "fictionBoundary": "Observer explicitly reports upside-down motionless hanging for at least a minute and subsequent flight as they approached. Wing opening, resulting swing and closing it are fictional, not a documented motor experiment. No distress/injury or involuntary reflex inferred.",
      "canon": "Maud remains adult female Corvus corax, Yellowstone forest and rock country44.7,-110.5. Source San Diego is provenance. Human rail structure is compatible with park infrastructure; do not claim this exact solar installation exists in Yellowstone. Preserve four admitted episodes including Single file and avatar. Independent adult episode; no family or age change.",
      "payoff": "She tries to help her feet by using a wing, loses the stillness, and lets the feet hold her. A specific upside-down bodily experiment, not a calling/heat or fake-bird misunderstanding."
    },
    {
      "id": "155-02",
      "characterId": "mira-mask",
      "platform": "instagram",
      "contentType": "story",
      "theme": "danger",
      "title": "The quiet part",
      "body": "Went into the hollow headfirst. The birds kept shouting. Pulled in my feet. Then my tail.\n\nQuiet.\n\nCouldn't turn around in there. Had to go back out bottom first.\n\nThe shouting started before I could see who was still waiting.",
      "photoId": 573979768,
      "localPath": "/tmp/freed-land155/573979768.jpg",
      "mediaSha1": "1a3e9d48fb945a61507f60f0934b6b958f057b68",
      "visibleScene": "A raccoon is tucked headfirst into a tree hollow; the ringed tail and rear fur are visible against the dark interior. No birds appear in this still. The bark, cavity and banded tail are sharp; identification is reinforced by the primary record.",
      "fictionBoundary": "Photographer explicitly reports bird mobbing and attempted hiding in this tree. Withdrawal of feet/tail, silence, inability to turn and backward emergence are fictional sequence. No particular limb anatomy or unseen species asserted. The hollow need not objectively be too narrow for every raccoon; this attempt is fictional.",
      "canon": "Mira remains female Procyon lotor, Great Smoky Mountains stream forest35.62,-83.47. Source St Louis is provenance. Observer calls animal he without visible sex evidence; image cannot sex it. No source sex annotation established. Preserve existing childhood rescue, adult water Stories and all held literal passages. Held bear-hollow sequence remains held and unchanged; this is a separate mobbing/exit incident, not its replacement.",
      "payoff": "After successfully getting away from the birds, the cramped hiding position obliges her to emerge toward them without seeing. Consequence is exposure and sound, not embarrassment before an audience."
    }
  ],
