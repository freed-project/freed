{
  "batch": "AQUATIC-VISUAL-44",
  "status": "draft_not_admitted",
  "proposals": [
    {
      "id": "aquatic-visual-44-01",
      "characterId": "silas-return",
      "identityNameBase": "Silas Return",
      "subject": "Oncorhynchus nerka",
      "platform": "facebook",
      "contentType": "story",
      "theme": "movement",
      "title": "What I remembered",
      "content": "I remembered enough water here to turn in.\n\nMy belly touched stone. I beat my tail and moved half my length. The water closed over my gills, then fell away from my head.\n\nAnother red back broke the surface beside mine. He pushed forward. I pushed with him.\n\nI had come so far to feel this water again. Now I wanted a little more of it.",
      "sourceIndex": 11,
      "decision": "propose_for_independent_review",
      "imageDecision": "pass_author_review",
      "proseDecision": "pass_author_review",
      "review": "Propose one visual Story for independent review. Visible exposed bodies and extremely shallow water support the returning adult physical constraint. Emotional history and short movement sequence are fiction. Placement before personal spawning is fictional chronology; source caption records spawning salmon in shallow water, not an individual migration stage.",
