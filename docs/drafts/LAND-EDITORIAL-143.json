  "candidates": [],
  "holds": [
    {
      "id": "143-01",
      "photoId": 193715506,
      "title": "A little taller",
      "body": "Stood beside another puffin while the tall black bird watched us. Stretched until my belly left the ground.\n\nThe puffin beside me stretched too.\n\nWe stayed like that until the tall bird turned away. Then both of us settled. My legs were shaking. I was glad not to be the only one.",
      "reason": "HOLD prose. Clear two-puffin/large-auk grouping is excellent. Invented joint stretching and retreat manufacture a social contest the photograph does not distinguish from ordinary standing. The concluding shared relief is familiar and does not yet earn this image.",
      "characterId": "brio-beak",
      "platform": "instagram",
      "contentType": "story",
      "status": "hold",
      "fictionBoundary": "Literal photograph does not document the narrated temporal sequence, motives, sex, or relationship. Drafted movement and interior experience are fiction.",
      "localPath": "/tmp/freed-land143/193715506.jpg"
    },
    {
      "id": "143-02",
      "photoId": 193715124,
      "title": "The other direction",
      "body": "We stood facing opposite ways. I kept turning to see what she was looking at. Each time, she turned too.\n\nFor a while neither of us saw much of the sea.\n\nI stopped first. Felt her feathers against my back and stayed looking out.",
      "reason": "HOLD prose. Close adult pair supports contact and fictional relationship, but mutual turning is an uneventful invented sequence and the final stillness is a portrait caption. No sex or partnership is established by the source.",
      "characterId": "brio-beak",
      "platform": "instagram",
      "contentType": "story",
      "status": "hold",
      "fictionBoundary": "Literal photograph does not document the narrated temporal sequence, motives, sex, or relationship. Drafted movement and interior experience are fiction.",
      "localPath": "/tmp/freed-land143/193715124.jpg"
    },
    {
      "id": "143-03",
      "photoId": 467763437,
      "title": "Still white",
      "body": "The pale puffin came out of the green. I looked behind him for the dark part.\n\nHe turned. It was still mostly missing.\n\nI followed him through the ferns until he stopped and looked back. Then I remembered that I had somewhere to go.",
      "reason": "HOLD prose and character fit. Exact image shows unusually pale central adult among normal-plumaged puffins, but following/being-caught-staring is a weak social embarrassment beat. Do not assign Brio the pale phenotype or call this albinism from pixels. No new pale identity proposed.",
      "characterId": "brio-beak",
      "platform": "instagram",
      "contentType": "story",
      "status": "hold",
      "fictionBoundary": "Literal photograph does not document the narrated temporal sequence, motives, sex, or relationship. Drafted movement and interior experience are fiction.",
      "localPath": "/tmp/freed-land143/467763437.jpg"
    }
