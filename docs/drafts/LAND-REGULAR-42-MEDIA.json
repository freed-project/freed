  "entries": [
    {
      "id": "land-regular-42-01",
      "identityNameBase": "Sylvie Stilt",
      "characterId": "sylvie-stilt",
      "fullSpecies": "Antigone canadensis",
      "title": "When we came down",
      "platform": "instagram",
      "contentType": "post",
      "status": "candidate",
      "independentLeadReview": "pending",
      "prose": "Every time she landed, I wanted to be in the air.\n\nShe bowed. I jumped. Came down while she was rising, and sprang up again before my legs had straightened. The grass brushed my toes. Then my feet hit a hollow and I had to take two quick steps to keep under my wings.\n\nShe landed beside me. We stood breathing, with our wings hanging loose.\n\nI lowered my head. She lowered hers. This time we both jumped. I could see her feet beside mine, clear of the grass.",
      "altText": "A flock of sandhill cranes stands in golden grass with patches of snow. Several foreground cranes spread their wings and leap; the left foreground bird has both feet off the ground.",
      "fictionBoundary": "The left airborne adult is the proposed narrator. Adult crane dancing is visible and explicitly described by FWS. The focal pair, female sexes, alternating timing, landing hollow, steps and shared final leap are fiction. This does not establish mates, a courtship outcome or continuous flight. Background birds are a flock, not an embarrassed audience.",
      "sourceUrl": "https://www.fws.gov/media/sandhill-cranes-dancing",
      "creator": "Rachel Portwood/USFWS",
      "license": "Public domain",
      "rightsEvidence": "Exact FWS media page: Media Usage Rights/License Public Domain",
      "sourceCachePath": "/tmp/freed-land42/sandhill-cranes-dancing.html",
      "original": {
        "url": "https://www.fws.gov/sites/default/files/images/2026-04/cranes-dancing-monte-vista-nwr-rachel-portwood-usfws.jpg",
        "localPath": "/tmp/freed-land42/sandhill-cranes-dancing-original.jpg",
        "width": 3965,
        "height": 2275,
        "bytes": 1912696,
        "sha1": "1203645c834877e8b861fcfa5876ab8ee223f7d6",
        "sha256": "07d23736bf7e5e79a1566b2539708c04ede4aee9cca12f25b9b0dfdb4793b922",
        "publishedLink": "<a href=\"https://www.fws.gov/sites/default/files/images/2026-04/cranes-dancing-monte-vista-nwr-rachel-portwood-usfws.jpg\" download=\"usfws-sandhill-cranes-dancing\">Original (3965 x 2275)"
      },
      "delivery": {
        "url": "https://www.fws.gov/sites/default/files/styles/max_1300x1300/public/images/2026-04/cranes-dancing-monte-vista-nwr-rachel-portwood-usfws.jpg?itok=Kt1bdl6U",
        "localPath": "/tmp/freed-land42/sandhill-cranes-dancing-delivery.jpg",
        "width": 1300,
        "height": 746,
        "bytes": 764557,
        "sha1": "13f721c1311b4ed93e87c65492a69e061ea0657b",
        "sha256": "6330930db8c913a35ab306023bc7d8a9250dde7058369bfbb4e86ae5e855a86e",
        "publishedLink": "<a href=\"https://www.fws.gov/sites/default/files/styles/max_1300x1300/public/images/2026-04/cranes-dancing-monte-vista-nwr-rachel-portwood-usfws.jpg?itok=Kt1bdl6U\" download=\"usfws-sandhill-cranes-dancing-large\">Large (1300 x 746)"
