    {
      "id": "LAND-STORIES-58-02",
      "characterId": "maud-overhead",
      "identityName": "Maud Overhead",
      "platform": "instagram",
      "contentType": "story",
      "title": "A little nearer",
      "body": "I came down to make him run. He walked towards me. I hopped back, and he came again. We've gone quite a distance now. I haven't turned round.",
      "wordCount": 28,
      "status": "hold",
      "holdReason": "Specific faceoff is visible, but original and published delivery have soft dark feather detail, a heavy blue cast and limited tonal separation. This does not meet the gorgeous image bar. Prose remains an unapproved literal draft, not an admission recommendation.",
