  "entries": [
    {
      "id": "botanical40-01",
      "characterId": "lionel-fringe",
      "subject": "shaggy mane mushroom",
      "species": "Coprinus comatus",
      "platform": "facebook",
      "contentType": "post",
      "theme": "transformation",
      "title": "Not quite finished",
      "body": "The little white cap beside me is still keeping itself together. I was like that very recently.\n\nThen I grew taller and lifted my rim. The edge turned black. A bead hung where I had been expecting more neat white fringe.\n\nI thought I could finish opening before anything came off.\n\nNow there is a black string of me hanging toward the grass. The younger cap has barely begun to lift.\n\nI would like to appear reassuring. It is difficult to look experienced while visibly becoming a drip.",
      "mediaSha1": "3af684f7eb63d02c01cc7672e84e40838756609b",
