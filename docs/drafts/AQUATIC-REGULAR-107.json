{
  "status": "one_regular_facebook_proposal_pending_independent_review",
  "admitted": 0,
  "proposals": [
    {
      "characterId": "mora-grey",
      "sourceIndex": 22,
      "episode": {
        "subject": "moray eel underwater",
        "platform": "facebook",
        "contentType": "post",
        "theme": "social",
        "title": "I had been here anyway",
        "body": "The wrasse asked how I always knew he was coming. I described the bump against the ceiling, the correction, the second bump. I was explaining that it was impossible not to notice when his head appeared above mine.\n\nThe wrasse left.\n\nHe asked whether I had been waiting.\n\nI said I had been here anyway.\n\nHe began to draw back. I raised my head a little and touched his.\n\nI told him to stay. He had arrived perfectly well this time.",
        "mediaSha1": "43ac01cd923ae245f3519bd5c2284510e33a24f4"
      },
      "authorDecision": "propose_for_independent_review",
      "visibleScene": "Two greyface moray heads emerge from the same reef opening. Foreground lower head is narrator; second head above and behind. Their heads are close; both eyes and body patterns are clear. Still does not establish sex, mating or touching.",
      "fictionBoundary": "Wrasse is established fictional acquaintance but not present in frame. Speech, habitual bumps, arrival, waiting, withdrawal, touch and invitation are fictional sequence. No observed injury, documented pair bond, sound recording or behavioral experiment is claimed.",
      "continuity": "Append after A better angle. Mora remains adult female Gymnothorax thyrsoideus at Anilao reef slope. Source is Tingloy, Batangas, physically compatible with her home region. Companion male pronouns are fictional casting, not photographic sex determination. No mating or offspring introduced. Existing seven draft slots, three admitted bodies, avatar and home remain unchanged.",
      "authorReview": "A complaint about his clumsy arrivals accidentally reveals how closely she has been attending to him. She first denies waiting, then makes an unambiguous physical invitation. The opening is a social setting, not a shelter renovation errand. Risk for lead: dialogue and temporality carry the incident; exact still supplies the two bodies and proximity rather than documenting sequence."
    }
  ],
