{
  "name": "@freed/sync",
  "version": "0.1.0",
  "description": "Cross-device sync for Freed",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./storage/filesystem": "./src/storage/filesystem.ts",
    "./storage/indexeddb": "./src/storage/indexeddb.ts",
    "./storage/repeatable-automerge-persistence": "./src/storage/repeatable-automerge-persistence.ts",
    "./cloud": "./src/cloud/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "node ../../node_modules/vitest/vitest.mjs run --maxWorkers=1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@freed/shared": "*",
    "@automerge/automerge": "^2.2.8",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  }
}
