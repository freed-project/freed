{
  "name": "@freed/sync",
  "version": "0.1.0",
  "description": "Cross-device sync for Freed",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./cloud": "./src/cloud/index.ts",
    "./cloud/library-core": "./src/cloud/library-core.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "node ../../node_modules/vitest/vitest.mjs run --maxWorkers=1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@freed/shared": "*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  }
}
