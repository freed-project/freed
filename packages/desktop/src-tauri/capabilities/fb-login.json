{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "fb-login",
  "description": "Allows the Facebook login window to report session completion",
  "windows": ["fb-login"],
  "remote": {
    "urls": ["https://facebook.com/*", "https://*.facebook.com/*"]
  },
  "permissions": ["core:event:allow-emit"]
}
